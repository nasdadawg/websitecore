# Cantclone-core environment — copy to .env.local and fill in.

# Supabase Postgres connection string (self-hosted Payload).
DATABASE_URI=

# Long random string for signing sessions/JWTs (openssl rand -base64 32).
PAYLOAD_SECRET=

# Public URL of this app (admin panel / server URL).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Upstash Redis (rate limiting) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Resend (owner notification email) ───────────────────────────────
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
